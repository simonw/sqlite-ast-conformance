  "sql": "CREATE TABLE IF NOT EXISTS orders (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INT NOT NULL REFERENCES customers(id) ON DELETE CASCADE, status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'shipped', 'delivered')), total REAL CHECK (total >= 0), discount REAL DEFAULT 0.0, net REAL GENERATED ALWAYS AS (total - discount) STORED, created_at TEXT DEFAULT CURRENT_TIMESTAMP, note TEXT COLLATE NOCASE, UNIQUE (customer_id, created_at), CONSTRAINT valid_discount CHECK (discount BETWEEN 0 AND total))",
